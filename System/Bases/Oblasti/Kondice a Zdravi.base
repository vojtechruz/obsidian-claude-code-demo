properties:
  start_date:
    displayName: Start
  due_date:
    displayName: Due
  status:
    displayName: Status
views:
  - type: table
    name: Projekty
    filters:
      and:
        - file.hasTag("Projekt")
        - oblast.contains(link("Oblasti/Kondice a Zdravi/Kondice a Zdravi"))
    order:
      - status
      - due_date
      - file.name
    sort:
      - property: status
        direction: ASC
    columns:
      - file.name
      - status
      - due_date
  - type: table
    name: Tasks
    filters:
      and:
        - file.hasTag("task")
        - oblast.contains(link("Oblasti/Kondice a Zdravi/Kondice a Zdravi"))
    order:
      - status
      - due
      - file.name
    sort:
      - property: status
        direction: ASC
    columns:
      - file.name
      - status
      - due
      - projects
  - type: table
    name: Notes
    filters:
      and:
        - file.inFolder("Oblasti/Kondice a Zdravi")
        - file.ext == "md"
        - file.name != "Kondice a Zdravi"
    order:
      - file.mtime
      - file.name
    sort:
      - property: file.mtime
        direction: DESC
    columns:
      - file.name
      - file.mtime
